{
  "name": "Ekraf Creative Nexus - Google GCC Edition",
  "dataColors": [
    "#FF6B4A",
    "#00D8D6",
    "#A855F7",
    "#10B981",
    "#FFB800",
    "#3B82F6",
    "#EC4899",
    "#14B8A6",
    "#F43F5E",
    "#6366F1",
    "#8B5CF6",
    "#06B6D4"
  ],
  "background": "#0A0F1D",
  "foreground": "#FFFFFF",
  "tableAccent": "#00D8D6",
  "good": "#10B981",
  "neutral": "#FFB800",
  "bad": "#F43F5E",
  "maximum": "#00D8D6",
  "center": "#A855F7",
  "minimum": "#FF6B4A",
  "null": "#64748B",
  "accent": "#00D8D6",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#111827" } },
            "transparency": 10
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F2937" } },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#000000" } },
            "position": "Outer",
            "transparency": 50,
            "preset": "BottomRight"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#F9FAFB" } },
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Left"
          }
        ],
        "labels": [
          {
            "fontColor": { "solid": { "color": "#9CA3AF" } },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#080C16" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontSize": 26,
            "fontFamily": "Segoe UI Bold",
            "fontColor": { "solid": { "color": "#00D8D6" } }
          }
        ],
        "categoryLabels": [
          {
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold",
            "fontColor": { "solid": { "color": "#9CA3AF" } }
          }
        ],
        "cardBackground": [
          {
            "show": true,
            "color": { "solid": { "color": "#111827" } }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#00D8D6" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#F3F4F6" } },
            "background": { "solid": { "color": "#1F2937" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
