        {
          "x": 20.0,
          "y": 545.0,
          "z": 12,
          "width": 1240.0,
          "height": 160.0,
          "config": "{\"name\": \"InsightsTextBox\", \"layouts\": [{\"id\": 0, \"position\": {\"x\": 20, \"y\": 545, \"width\": 1240, \"height\": 160}}], \"singleVisual\": {\"visualType\": \"textbox\", \"objects\": {\"general\": [{\"properties\": {\"paragraphs\": [{\"textRuns\": [{\"value\": \"RINGKASAN 5 KEY INSIGHTS & REKOMENDASI STRATEGIS EKRAF:\\n\", \"textStyle\": {\"fontFamily\": \"Segoe UI Bold\", \"fontSize\": \"11pt\", \"color\": \"#FF6B4A\"}}]}, {\"textRuns\": [{\"value\": \"1. Hegemoni Big 3: \", \"textStyle\": {\"fontFamily\": \"Segoe UI Bold\", \"fontSize\": \"9pt\", \"color\": \"#00D8D6\"}}, {\"value\": \"Kuliner (23.9%), Fesyen (13.6%), Kriya (9.3%) kuasai 46.8% pelaku di Ekraf Hub dan >74% PDB Ekraf nasional.\\n\", \"textStyle\": {\"fontSize\": \"9pt\", \"color\": \"#CBD5E1\"}}, {\"value\": \"2. Kesenjangan Wilayah: \", \"textStyle\": {\"fontFamily\": \"Segoe UI Bold\", \"fontSize\": \"9pt\", \"color\": \"#00D8D6\"}}, {\"value\": \"69.3% pelaku usaha terpusat di Pulau Jawa (Jabar 2.232, Jatim 1.380, DKI 1.183 pelaku) akibat disparitas kesiapan digital.\\n\", \"textStyle\": {\"fontSize\": \"9pt\", \"color\": \"#CBD5E1\"}}, {\"value\": \"3. Kausalitas Digital: \", \"textStyle\": {\"fontFamily\": \"Segoe UI Bold\", \"fontSize\": \"9pt\", \"color\": \"#00D8D6\"}}, {\"value\": \"80.2% pelaku UMKM 'Full Digital' mencatatkan kenaikan omzet (42% naik >30%), berbanding hanya 25% pada kelompok offline.\\n\", \"textStyle\": {\"fontSize\": \"9pt\", \"color\": \"#CBD5E1\"}}, {\"value\": \"4. Akses Modal Terbatas: \", \"textStyle\": {\"fontFamily\": \"Segoe UI Bold\", \"fontSize\": \"9pt\", \"color\": \"#00D8D6\"}}, {\"value\": \"58% masih memakai modal pribadi; penetrasi fintech produktif (12%) dan KUR bank (22%) perlu didorong dengan credit scoring digital.\", \"textStyle\": {\"fontSize\": \"9pt\", \"color\": \"#CBD5E1\"}}]}]}}]}}}"
        }
